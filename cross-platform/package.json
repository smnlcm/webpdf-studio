{
  "name": "webpdf-studio",
  "version": "4.0.1",
  "description": "WebPDF Studio v4.0.1 FINAL BASIC - Powered by mavvi.online",
  "homepage": "https://mavvi.online",
  "repository": {
    "type": "git",
    "url": "https://github.com/smnlcm/webpdf-studio.git"
  },
  "author": "mavvi.online (smnlcm)",
  "license": "GPL-3.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "make": "electron-builder",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --linux --x64"
  },
  "build": {
    "appId": "online.mavvi.webpdfstudio",
    "productName": "WebPDF Studio",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "maintainer": "contact@mavvi.online",
      "category": "Utility"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-deb": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  }
}
